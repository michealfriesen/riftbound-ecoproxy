{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "card.schema.json",
  "title": "Riftbound card set",
  "description": "Schema for a single Riftbound set file (e.g. data/sets/OGN.json).",
  "type": "object",
  "required": ["code", "name", "cards"],
  "additionalProperties": false,
  "properties": {
    "code": {
      "description": "Short set code, e.g. OGN.",
      "type": "string",
      "pattern": "^[A-Z0-9]{2,6}$"
    },
    "name": {
      "description": "Human-readable set name.",
      "type": "string",
      "minLength": 1
    },
    "cards": {
      "description": "Ordered list of cards in this set.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["variantNumber", "collectorNumber", "name", "type"],
        "additionalProperties": false,
        "properties": {
          "variantNumber": {
            "description": "Globally unique card identifier, e.g. OGN-001.",
            "type": "string",
            "pattern": "^[A-Z0-9]+-[0-9]+(?:-[0-9]+)?$"
          },
          "collectorNumber": {
            "description": "Numeric position within the set.",
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "description": "Card name as printed.",
            "type": "string",
            "minLength": 1
          },
          "type": {
            "description": "Card type.",
            "enum": ["unit", "spell", "gear", "battlefield", "legend", "rune"]
          },
          "energy": {
            "description": "Energy cost. Null when not applicable.",
            "type": ["integer", "null"],
            "minimum": 0
          },
          "power": {
            "description": "Power value. Null when not applicable.",
            "type": ["integer", "null"],
            "minimum": 0
          },
          "might": {
            "description": "Might value (can be negative). Null when not applicable.",
            "type": ["integer", "null"]
          },
          "colors": {
            "description": "Color identities for this card.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "tags": {
            "description": "Gameplay tags (subtypes, traits, etc.).",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "description": {
            "description": "Rules text, including inline icon codes such as [Tap] and [Might].",
            "type": "string"
          },
          "variantImageUrl": {
            "description": "URL of the full-art card image used by the proxy renderer.",
            "type": ["string", "null"],
            "format": "uri"
          }
        }
      }
    }
  }
}
